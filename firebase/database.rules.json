{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && !$room.beginsWith('elg-rk') && !$room.beginsWith('elg-am')",
        "peers": {
          "$peer": {
            ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid) && (!newData.exists() || newData.child('uid').val() === auth.uid)"
          }
        },
        "msgs": {
          ".indexOn": [
            "t"
          ],
          "$msg": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && newData.child('t').val() === now",
            ".validate": "newData.hasChildren(['topic', 'from', 'uid', 't']) && newData.child('topic').isString() && newData.child('topic').val().length < 12"
          }
        }
      }
    },
    "ranks": {
      ".read": true,
      ".indexOn": [
        "rating"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && root.child('config/rankedServer').val() !== true"
      }
    },
    "users": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 40"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "config": {
      ".read": true,
      ".write": false
    },
    "ranked": {
      "$room": {
        ".read": "auth != null",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && ($room.beginsWith('elg-rk') || $room.beginsWith('elg-am'))",
            ".validate": "newData.hasChild('cls') && newData.child('cls').isString() && (newData.hasChild('hc') || newData.hasChild('gn'))"
          }
        },
        "end": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('ranked/'+$room+'/players/'+$uid).exists() && !root.child('ranked/'+$room+'/result').exists()",
            ".validate": "newData.hasChild('priv') && newData.child('priv').isNumber()"
          }
        },
        "result": {
          ".write": false
        }
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "claims": {
      ".read": false,
      ".write": false
    },
    "decks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren()"
      }
    }
  }
}